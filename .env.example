# Copy to windmill/.env (not committed). Used by docker-compose.yml only
# (local Windmill). Deploying scripts/schedules is done with the wmill CLI,
# see README.md.

# Windmill image tag. Pinned to the version the CLI files were generated
# with; keep the CLI (`npm i -g windmill-cli@<same>`) on the same version.
WM_VERSION=1.871.1
WM_PORT=8000
WM_BASE_URL=http://localhost:8000
WM_DB_PASSWORD=changeme
