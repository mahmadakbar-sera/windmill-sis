# Copy to windmill/.env (not committed) and adjust.

# Windmill image tag. `main` follows the latest build; pin a release
# (e.g. 1.xxx.x) for staging/prod.
WM_VERSION=main
WM_PORT=8000
WM_BASE_URL=http://localhost:8000
WM_DB_PASSWORD=changeme

# Used by setup.sh only.
WM_URL=http://localhost:8000
WM_EMAIL=admin@windmill.dev
WM_PASSWORD=changeme
WM_WORKSPACE=sis
# How the worker reaches claim-service (service name on sera-sis-network).
CLAIM_SERVICE_BASE_URL=http://claim-service:3003
# Must equal INTERNAL_API_KEY in SERA_SIS_ClaimService/.env.
CLAIM_INTERNAL_API_KEY=
# true: create the hourly schedule enabled. Keep false until the job has been
# tested against the target database.
SCHEDULE_ENABLED=false
